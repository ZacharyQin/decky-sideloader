{
  "name": "decky-sideloader",
  "version": "0.5.0",
  "description": "List, update, and install zip-sourced Decky plugins from GitHub releases.",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "release:notes": "python3 -B scripts/release_notes.py",
    "package-plugin": "python3 -B scripts/package-plugin.py",
    "test": "bun test tests",
    "test:python": "python3 -B -m unittest discover -s tests -v"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/react-router": "5.1.20",
    "@types/react-test-renderer": "19.1.0",
    "@types/webpack": "^5.28.5",
    "react": "19.1.1",
    "react-test-renderer": "19.1.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "compare-versions": "6.1.1",
    "qrcode-generator": "1.4.4",
    "react-icons": "^5.3.0",
    "react-markdown": "10.1.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
